    "vendedor_id": usuariosIds[vendedor_index]._id,
    "calificaciones": [
      {
        "estrellas": (i % 5) + 1,
        "comentario": i % 2 === 0 ? "Excelente producto, cumple con lo esperado." : "Buen rendimiento, aunque podría mejorar el diseño.",

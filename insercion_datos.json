        "interacciones": [
          {
            "comentario": "Sí, tiene garantía de 1 año directamente con el fabricante.",
            "fecha": new Date(2025, (i % 12), (i % 28) + 1),
            "vendedor_nombre": "Vendedor " + vendedor_index,
            "comprador_nombre": i % 2 === 0 ? "" : "Comprador " + (i + 1)
          }
        ]
